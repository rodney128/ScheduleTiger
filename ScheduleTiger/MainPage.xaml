<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScheduleTiger.MainPage"
             BackgroundColor="#0B0B0B">

    <ScrollView>
        <VerticalStackLayout Padding="18,24,18,18"
                             Spacing="16">
            <VerticalStackLayout Spacing="10">
                <Image Source="scheduletiger_logo.png"
                       HeightRequest="108"
                       WidthRequest="108"
                       HorizontalOptions="Center"
                       Aspect="AspectFit" />

                <Label Text="ScheduleTiger"
                       TextColor="#F0D28A"
                       FontSize="30"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />

                <Label Text="Reminders, routines, and checklists"
                       TextColor="#F7F2E8"
                       FontSize="15"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border BackgroundColor="#171717"
                    Stroke="#7C5A16"
                    StrokeThickness="1"
                    Padding="16"
                    StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Reminder notifications"
                           TextColor="#F0D28A"
                           FontAttributes="Bold"
                           FontSize="18" />

                    <Button Text="Enable reminder notifications"
                            Clicked="OnEnableNotificationsClicked"
                            BackgroundColor="#D39A28"
                            TextColor="#0B0B0B"
                            FontAttributes="Bold"
                            CornerRadius="14" />

                    <Button Text="Send test notification now"
                            Clicked="OnSendTestNotificationNowClicked"
                            BackgroundColor="#3A2110"
                            TextColor="#F7F2E8"
                            CornerRadius="14" />

                    <Button Text="Test notification in 30 seconds"
                            Clicked="OnTestNotificationClicked"
                            BackgroundColor="#3A2110"
                            TextColor="#F7F2E8"
                            CornerRadius="14" />

                    <Button Text="Open notification settings"
                            Clicked="OnOpenNotificationSettingsClicked"
                            BackgroundColor="#2A2211"
                            TextColor="#F7F2E8"
                            CornerRadius="14" />

                    <Button Text="Open channel settings"
                            Clicked="OnOpenChannelSettingsClicked"
                            BackgroundColor="#2A2211"
                            TextColor="#F7F2E8"
                            CornerRadius="14" />

                    <Button Text="Open alarm permission settings"
                            Clicked="OnOpenAlarmPermissionClicked"
                            BackgroundColor="#2A2211"
                            TextColor="#F7F2E8"
                            CornerRadius="14" />

                    <Label Text="{Binding StatusMessage}"
                           TextColor="#CBB98A"
                           FontSize="12"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#171717"
                    Stroke="#3D2A07"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding SavedRemindersHeader}"
                           TextColor="#F0D28A"
                           FontAttributes="Bold"
                           FontSize="18" />

                    <CollectionView ItemsSource="{Binding Reminders}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Border BackgroundColor="#171717"
                                    Stroke="#3D2A07"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="18">
                                <Label Text="No reminders saved yet."
                                       TextColor="#CBB98A"
                                       HorizontalTextAlignment="Center" />
                            </Border>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#171717"
                                        Stroke="#3D2A07"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 18"
                                        Padding="14"
                                        Margin="0,0,0,12">
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="10">
                                            <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}"
                                                      CheckedChanged="OnReminderCheckedChanged"
                                                      Color="#D39A28"
                                                      VerticalOptions="Start" />

                                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                <Label Text="{Binding Title}"
                                                       FontSize="18"
                                                       FontAttributes="Bold"
                                                       TextColor="#FFF9EF">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding IsDone}"
                                                                     Value="True">
                                                            <Setter Property="TextColor" Value="#A0A0A0" />
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>

                                                <Label Text="{Binding Notes}"
                                                       IsVisible="{Binding Notes, Converter={StaticResource StringNotEmptyConverter}}"
                                                       TextColor="#CBB98A"
                                                       FontSize="13"
                                                       LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>

                                            <Button Grid.Column="2"
                                                    Text="Delete"
                                                    Clicked="OnDeleteReminderClicked"
                                                    BackgroundColor="#3A2110"
                                                    TextColor="#F7F2E8"
                                                    CornerRadius="12"
                                                    Padding="12,8"
                                                    MinimumHeightRequest="40" />
                                        </Grid>

                                        <HorizontalStackLayout Spacing="8">
                                            <Border BackgroundColor="#2A2211"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="8,4">
                                                <Label Text="{Binding Tag}"
                                                       TextColor="#F0D28A"
                                                       FontSize="12" />
                                            </Border>

                                            <Label Text="{Binding DueDateDisplay}"
                                                   TextColor="#F7F2E8"
                                                   FontSize="12"
                                                   VerticalTextAlignment="Center" />
                                        </HorizontalStackLayout>

                                        <Border BackgroundColor="#2A2211"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="10,6"
                                                HorizontalOptions="Start">
                                            <Label Text="Upcoming"
                                                   TextColor="#A8D8A0"
                                                   FontSize="12">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsDone}"
                                                                 Value="True">
                                                        <Setter Property="Text" Value="Done" />
                                                        <Setter Property="TextColor" Value="#A8D8A0" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsOverdue}"
                                                                 Value="True">
                                                        <Setter Property="Text" Value="Overdue" />
                                                        <Setter Property="TextColor" Value="#E6A4A4" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#171717"
                    Stroke="#7C5A16"
                    StrokeThickness="1"
                    Padding="16"
                    StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Add reminder"
                           TextColor="#F0D28A"
                           FontAttributes="Bold"
                           FontSize="18" />

                    <Entry Placeholder="Title *"
                           Text="{Binding NewTitle}"
                           BackgroundColor="#222222"
                           TextColor="#FFF9EF"
                           PlaceholderColor="#A98A4A"
                           ClearButtonVisibility="WhileEditing" />

                    <Editor Placeholder="Notes"
                            Text="{Binding NewNotes}"
                            AutoSize="TextChanges"
                            HeightRequest="88"
                            BackgroundColor="#222222"
                            TextColor="#FFF9EF"
                            PlaceholderColor="#A98A4A" />

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="10">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                            <Label Text="Tag"
                                   TextColor="#F7F2E8"
                                   FontSize="13" />
                            <Picker ItemsSource="{Binding TagOptions}"
                                    SelectedItem="{Binding SelectedTag}"
                                    BackgroundColor="#222222"
                                    TextColor="#FFF9EF"
                                    TitleColor="#A98A4A" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                            <Label Text="Due date"
                                   TextColor="#F7F2E8"
                                   FontSize="13" />
                            <DatePicker Date="{Binding SelectedDate}"
                                        BackgroundColor="#222222"
                                        TextColor="#FFF9EF" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="6">
                            <Label Text="Due time"
                                   TextColor="#F7F2E8"
                                   FontSize="13" />
                            <TimePicker Time="{Binding SelectedTime}"
                                        BackgroundColor="#222222"
                                        TextColor="#FFF9EF" />
                        </VerticalStackLayout>
                    </Grid>

                    <Button Text="Add reminder"
                            Clicked="OnAddReminderClicked"
                            BackgroundColor="#D39A28"
                            TextColor="#0B0B0B"
                            FontAttributes="Bold"
                            CornerRadius="14" />

                    <Label Text="ScheduleTiger stores reminders locally on this device."
                           TextColor="#CBB98A"
                           FontSize="12" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>